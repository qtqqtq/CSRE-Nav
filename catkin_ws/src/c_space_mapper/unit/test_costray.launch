<launch>
  <!-- Offline costray generation test.
       Loads mapper_node, feeds it a synthetic /map_from_gazebo, and opens
       rviz to visualize /cost_ray_image. No Gazebo / lidar / sim time needed. -->

  <!-- Synthetic OccupancyGrid publisher (replaces lidar_to_occupancy_node) -->
  <node name="fake_occupancy_pub" pkg="c_space_mapper" type="fake_occupancy_pub.py"
        output="screen" />

  <!-- Configuration Space mapper (generates cost rays) -->
  <node name="c_space_mapper_node" pkg="c_space_mapper" type="c_space_mapper_node"
        output="screen">
    <rosparam file="$(find c_space_mapper)/config/mapper_node.yaml" />
  </node>

  <!-- rviz: visualize /cost_ray_image (+ /cspace_vis) -->
  <node name="rviz" pkg="rviz" type="rviz"
        args="-d $(find c_space_mapper)/unit/costray.rviz" />
</launch>
