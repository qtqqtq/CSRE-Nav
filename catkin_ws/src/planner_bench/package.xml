<?xml version="1.0"?>
<package format="2">
  <name>planner_bench</name>
  <version>0.1.0</version>
  <description>
    A shared static-obstacle benchmark for the CNN-SAC c-space policy and the
    NeuPAN planner.  Both are evaluated on the same world, the same robot (the
    Limo), the same seeded goal set, and the same ground-truth scoring harness --
    only the `planner` argument differs.  Produces one JSON report per run plus a
    side-by-side comparison.
  </description>

  <maintainer email="qtqqtq@todo.todo">qtqqtq</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <!-- rosgraph_msgs/Log on /rosout: how the harness learns that a planner has
       finished loading and is actually listening, rather than assuming it. -->
  <depend>rosgraph_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>tf</depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>limo_description</exec_depend>
  <exec_depend>limo_gazebo_sim</exec_depend>
  <exec_depend>sac_cspace_ros</exec_depend>
  <exec_depend>neupan_ros</exec_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
