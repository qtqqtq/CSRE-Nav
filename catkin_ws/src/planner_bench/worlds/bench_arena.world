<?xml version="1.0" ?>
<!--
  planner_bench shared evaluation arena.

  Pure primitives, everything <static>, no <plugin>, no model:// URI - so it
  loads with no network and every obstacle reduces to an exact axis-aligned
  bounding box for the collision ground truth (see src/bench_common.py).

  Authoring rules this file obeys, all of them load-bearing:

    * One <model> per obstacle, never nested.  bench_common.parse_world_obstacles
      walks `root.iter('model')`, which is recursive, so a nested model would be
      counted twice.
    * <geometry> is a direct child of <collision> (the parser uses find(), not
      iter()).
    * No model name contains "plane"/"ground"/"floor" - that substring match is
      how the parser skips the drivable floor.  The floor's name therefore must
      contain one of them, hence "ground_plane".
    * Axis-aligned only: no link/collision yaw.  The parser takes the bounding
      box of the rotated corners, so a diagonal wall's AABB over-approximates and
      could look impassable.
    * Boundary walls are 0.25 m thick (infer_bounds keys off wall thinness; the
      upstream heuristic needed < 0.4 m) and 10.5 m long so the corners overlap.
    * Every obstacle is >= 1.0 m tall.  The lidar sits at z ~ 0.116 m, so
      anything shorter would be invisible to both planners - a silent trap.
    * No free-standing obstacle pair is closer than 1.6 m, and no obstacle is
      closer than 1.6 m to a wall.  That budget comes from the widest footprint
      under test: the cspace checkpoint dilates obstacles by its 1.20 m body
      length, so a 1.6 m corridor is the narrowest opening it can still perceive
      as open at all.  Checked by `bench_common.py -selftest`.

  Interior is x,y in [-5, 5].  Start pose is (-2.5, -1.0, yaw 0).
-->
<sdf version='1.6'>
  <world name='bench_arena'>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose frame=''>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.5 -1</direction>
    </light>

    <!-- Drivable floor.  Named "ground_plane" on purpose: the substring match
         on "ground"/"plane" is what keeps it out of the obstacle list. -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
              <torsional><ode/></torsional>
            </friction>
            <contact><ode/></contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <!-- Physics timing here is NOT cosmetic: it decides whether the Limo
         survives a collision at all.

         At max_step_size 0.001 / 1000 Hz, all six of a full speed wall impact
         suite exploded the robot.  The failure is a hard ODE blow up, not a
         slow drift: /gazebo/link_states shows limo::base_footprint going from
         rest to z = 20.95 m at |v| = 219180 m/s and |w| = 1258296 rad/s within
         20 ms, after which every pose reads NaN and Gazebo reports the model at
         an exact identity pose, permanently.  set_model_state then returns
         success and does nothing, and a later delete_model aborts gzserver
         outright (exit 134, boost::lock_error in pthread_mutex_lock).

         That signature is worth recognising because it masquerades as a planner
         bug: the planner commands a real velocity, the robot does not move, so
         every trial is scored NO_MOTION and it looks like a planner that never
         publishes cmd_vel.

         0.01 / 100 Hz is what the Limo is actually tuned for: 7 of the 8 worlds
         shipped in limo_gazebo_sim use it (only block.world uses 1 ms), and
         neupan's own gazebo_limo worlds use 0.002.  With it the same six
         impacts all survive, and the robot stops at x = 4.853 against a wall
         whose inner face is at x = 5.0 (half length 0.145) - in contact rather
         than through it.

         Both planners share this world, so the setting is common to the
         comparison and favours neither. -->
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- ================= boundary walls (inner faces at +/-5.0) ============ -->

    <model name='wall_north'>
      <pose frame=''>0 5.125 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 1.25 0 -0 0</pose>
          <geometry><box><size>10.5 0.25 2.5</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 1.25 0 -0 0</pose>
          <geometry><box><size>10.5 0.25 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <model name='wall_south'>
      <pose frame=''>0 -5.125 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 1.25 0 -0 0</pose>
          <geometry><box><size>10.5 0.25 2.5</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 1.25 0 -0 0</pose>
          <geometry><box><size>10.5 0.25 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <model name='wall_east'>
      <pose frame=''>5.125 0 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 1.25 0 -0 0</pose>
          <geometry><box><size>0.25 10.5 2.5</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 1.25 0 -0 0</pose>
          <geometry><box><size>0.25 10.5 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <model name='wall_west'>
      <pose frame=''>-5.125 0 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 1.25 0 -0 0</pose>
          <geometry><box><size>0.25 10.5 2.5</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 1.25 0 -0 0</pose>
          <geometry><box><size>0.25 10.5 2.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <!-- ===================== central divider, 2.0 m doorway ===============
         Splits the arena into a west room and an east room.  Both segments run
         into a boundary wall, so the ONLY way east is the y in [-1, 1] doorway.
         A goal placed east of the divider is therefore only fair if its straight
         line from the start threads that doorway - which is exactly what the
         line-of-sight rejection in gen_goals.py enforces.
         ==================================================================== -->

    <model name='divider_south'>
      <pose frame=''>0.5 -3.0 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 1.0 0 -0 0</pose>
          <geometry><box><size>0.25 4.0 2.0</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 1.0 0 -0 0</pose>
          <geometry><box><size>0.25 4.0 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <model name='divider_north'>
      <pose frame=''>0.5 3.0 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 1.0 0 -0 0</pose>
          <geometry><box><size>0.25 4.0 2.0</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 1.0 0 -0 0</pose>
          <geometry><box><size>0.25 4.0 2.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <!-- ===================== dead-end pocket, SW corner ==================
         Uses the arena's own south and west walls as two of its three sides, so
         it adds no spurious corridors.  Entrance is the 1.775 m gap in +y,
         wide enough that BOTH planners can physically enter - a trap only one
         of them fits through would measure footprint, not navigation.

         Kept as a hazard, never a destination: a goal inside it sits behind a
         concave obstacle and would be unsolvable for both planners by
         construction (see the LOS rule).
         ==================================================================== -->

    <model name='pocket_east'>
      <pose frame=''>-2.7 -3.7 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 0.75 0 -0 0</pose>
          <geometry><box><size>0.25 2.6 1.5</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 0.75 0 -0 0</pose>
          <geometry><box><size>0.25 2.6 1.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <model name='pocket_north'>
      <pose frame=''>-4.8 -2.4 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 0.75 0 -0 0</pose>
          <geometry><box><size>0.4 0.25 1.5</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 0.75 0 -0 0</pose>
          <geometry><box><size>0.4 0.25 1.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <!-- ===================== free-standing boxes =========================
         Three boxes in open floor, each >= 1.6 m clear of everything, so they
         cannot be solved by wall-following: the planner has to actually go
         around them.
         ==================================================================== -->

    <model name='box_south_east'>
      <pose frame=''>2.8 -2.5 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 0.5 0 -0 0</pose>
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 0.5 0 -0 0</pose>
          <geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <model name='box_north_east'>
      <pose frame=''>2.9 2.6 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 0.5 0 -0 0</pose>
          <geometry><box><size>0.8 1.2 1.0</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 0.5 0 -0 0</pose>
          <geometry><box><size>0.8 1.2 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

    <model name='box_north_west'>
      <pose frame=''>-2.5 3.0 0 0 -0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <pose frame=''>0 0 0.5 0 -0 0</pose>
          <geometry><box><size>1.2 0.6 1.0</size></box></geometry>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <pose frame=''>0 0 0.5 0 -0 0</pose>
          <geometry><box><size>1.2 0.6 1.0</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
      <static>1</static>
    </model>

  </world>
</sdf>
