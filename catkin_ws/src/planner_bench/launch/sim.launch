<?xml version="1.0"?>
<!--
  Simulation only: Gazebo + the bench arena + one Limo + its controllers.
  No planner, no rvo_ros, no actors.

  The upstream reference is
  neupan_ros/example/gazebo_limo/launch/gazebo_limo_env_complex_20.launch, minus
  three things that made it unusable here:

    * rvo_ros / rvo_node - its rvo_node segfaults (exit -11) and it is the
      reason the upstream env could not be reused.
    * the 10 dynamic actor clones - the bench is static-obstacle only.
    * `-model 'limo$(arg robot_namespace)'`, which with robot_namespace:=/ names
      the model literally "limo/".  Every /gazebo/model_states lookup would then
      need that slash.  The model name is independent of robot_namespace, so
      `-model limo` is free and much less error-prone.

  robot_state_publisher needs NO extra parameters.  In particular do not set
  `publish_fixed_joints` - it does not exist in rsp 1.15.3 (the version in this
  image) and would be a silent no-op.  Fixed joints go out on /tf_static via
  `use_tf_static`, which defaults to true.

  Note the Limo xacro declares no <xacro:arg name="robot_namespace">, so it MUST
  be passed on the command line or xacro aborts with "undefined arg".
-->
<launch>
  <arg name="world" default="$(find planner_bench)/worlds/bench_arena.world"/>

  <!-- Spawn pose.  Defaults match config/bench.yaml arena.start, and are the
       origin of the odom frame on purpose: the skid-steer plugin derives
       odometry from the model's Gazebo world pose, so spawning here makes
       odom == world and removes a whole class of frame conversion bug. -->
  <arg name="x" default="-2.5"/>
  <arg name="y" default="-1.0"/>
  <arg name="z" default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <arg name="robot_namespace" default="/"/>
  <arg name="gui" default="true"/>
  <arg name="verbose" default="false"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="headless" value="false"/>
    <arg name="debug" value="false"/>
    <arg name="verbose" value="$(arg verbose)"/>
  </include>

  <!-- robot_namespace:=/ makes the plugin's *relative* cmd_vel/odom resolve to
       /cmd_vel and /odom at the root, and broadcasts tf odom -> base_footprint.
       The laser topic is NOT namespaced this way - limo_gazebo.gazebo hardcodes
       the absolute /limo/scan with frame laser_link. -->
  <param name="robot_description"
         command="$(find xacro)/xacro '$(find limo_description)/urdf/limo_four_diff.xacro' robot_namespace:=$(arg robot_namespace)"/>

  <node name="spawn_limo_model" pkg="gazebo_ros" type="spawn_model"
        args="-x $(arg x) -y $(arg y) -z $(arg z) -Y $(arg yaw)
              -unpause -urdf -param robot_description -model limo"/>

  <rosparam file="$(find limo_gazebo_sim)/config/limo_four_diff_control.yaml" command="load"/>
  <node name="controller_spawner" pkg="controller_manager" type="spawner"
        respawn="false" output="screen" args="limo_state_controller"/>

  <!-- Publishes base_footprint -> base_link -> laser_link from the URDF's fixed
       joints.  cspace looks up base_link -> laser_link on EVERY scan callback
       and silently does nothing (throttled INFO, then return) if it fails, so
       this node failing is the single most likely way to get a planner that
       looks alive but never moves. -->
  <node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher"/>
</launch>
