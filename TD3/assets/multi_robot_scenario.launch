<launch>
<arg name="gui" value="false"/>

   <!-- Gazebo  -->
  <include file="$(find multi_robot_scenario)/launch/empty_world.launch" />

  <!-- Robot with diff drive -->
  <include file="$(find multi_robot_scenario)/launch/pioneer3dx.gazebo.launch">
     <arg name="robot_name" value="r1" />
     <arg name="robot_position" value="-x 0.0 -y 0.0 -z 0.01 -R 0 -P 0 -Y +0.0" />
   </include>

  <!-- ===== c_space_mapper pipeline ===== -->
  <!-- LiDAR → OccupancyGrid converter -->
  <node name="lidar_to_occupancy_node" pkg="c_space_mapper" type="lidar_to_occupancy_node" output="screen">
    <rosparam file="$(find c_space_mapper)/config/lidar_to_occupancy_node.yaml" />
  </node>

  <!-- 3D Configuration Space mapper -->
  <node name="c_space_mapper_node" pkg="c_space_mapper" type="c_space_mapper_node" output="screen">
    <rosparam file="$(find c_space_mapper)/config/mapper_node.yaml" />
    <param name="use_sim_time" value="true" />
  </node>
  <!-- ==================================== -->

  <!-- RVIZ -->
  <node pkg="rviz" type="rviz" name="rviz" args="-d $(find multi_robot_scenario)/launch/pioneer3dx.rviz" />

</launch>
